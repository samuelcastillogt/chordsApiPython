# ChordWeaver API — copy to `.env` for local development (`cp .env.example .env`).
# In production set these as environment variables of your host (Vercel, Docker...).

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Firebase (Authentication + Firestore) ----------------------------------
# Project ID from Firebase console > Project settings > General (e.g. chordweaver-12345).
# Used to verify sign-in tokens and to open Firestore. Empty disables accounts and saved
# progressions (analysis keeps working).
FIREBASE_PROJECT_ID=

# Service account key for Firestore: Firebase console > Project settings > Service accounts >
# Generate new private key. Paste the JSON on one line, or base64 of the file:
#   base64 -i service-account.json | tr -d '\n'
# Keep it secret: never commit it. Empty uses Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS=/path/key.json, or Google Cloud's own identity).
FIREBASE_SERVICE_ACCOUNT=

# Firestore database name; "(default)" unless you created a named database.
FIRESTORE_DATABASE="(default)"
# Prefix of this app's collections (chordweaver_users, chordweaver_progressions), so the API can
# share a Firebase project with other apps without touching their data.
FIRESTORE_COLLECTION_PREFIX=chordweaver_

# --- Local emulators (development only) --------------------------------------
# Firebase Auth emulator, e.g. 127.0.0.1:9099. Its tokens are unsigned, so this is ignored
# when ENVIRONMENT=production or on Vercel.
FIREBASE_AUTH_EMULATOR_HOST=
# Firestore emulator, e.g. 127.0.0.1:8080 (read by the Google client library itself).
FIRESTORE_EMULATOR_HOST=

# --- HTTP -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://samuelcastillogt.github.io
# Public URL of the web app. Share links (/p/{id}) show a preview and then redirect there.
WEB_URL=https://samuelcastillogt.github.io/chordsAppWeb

# --- Billing -----------------------------------------------------------------
# Payment processor for /api/v1/billing. "mock" (the only option for now) activates the plan
# on checkout without charging anything: useful until Paddle / Lemon Squeezy / Recurrente is set up.
BILLING_PROVIDER=mock
