# Local development uses SQLite. In production point this to Postgres
# (Neon, Supabase, Railway...): postgres:// URLs are converted to asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./chordweaver.db
# Required in production: accounts stay disabled while the default value is used.
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://samuelcastillogt.github.io
ENVIRONMENT=development
